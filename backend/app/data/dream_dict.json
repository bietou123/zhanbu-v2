{
  "version": "0.1.0",
  "source": "周公解梦（精选条目，可扩展）",
  "entries": [
    {"keywords": ["蛇", "白蛇", "青蛇"], "category": "动物", "interpretation": "梦见蛇，主财禄；女子梦蛇多为得子之兆；蛇缠身则需防小人。"},
    {"keywords": ["龙", "金龙", "飞龙"], "category": "动物", "interpretation": "梦见龙，大吉。预示尊贵之人相助，事业腾达。"},
    {"keywords": ["虎", "老虎"], "category": "动物", "interpretation": "梦见老虎，主威权或惊恐；伏虎则胜，被追则险。"},
    {"keywords": ["猫", "黑猫"], "category": "动物", "interpretation": "梦见猫，主小人窥伺；黑猫尤需谨慎人际关系。"},
    {"keywords": ["狗", "黑狗", "白狗"], "category": "动物", "interpretation": "梦见狗，多主忠仆贵人；黑狗则需防口舌。"},
    {"keywords": ["鱼", "锦鲤", "金鱼"], "category": "动物", "interpretation": "梦见鱼，主财禄丰盈；锦鲤大吉，预示富贵。"},
    {"keywords": ["水", "大水", "河水", "海"], "category": "自然", "interpretation": "梦见水，象征情感与机会；清水主吉，浊水主烦忧。"},
    {"keywords": ["火", "大火", "烈火"], "category": "自然", "interpretation": "梦见火，主热情与变革；旺火吉，灭火则事不成。"},
    {"keywords": ["山", "登山", "爬山"], "category": "自然", "interpretation": "梦见登山，预示事业向上；中途跌落则需警惕。"},
    {"keywords": ["雪", "下雪"], "category": "自然", "interpretation": "梦见下雪，主有喜事降临；瑞雪兆丰年。"},
    {"keywords": ["雨", "下雨", "暴雨"], "category": "自然", "interpretation": "梦见下雨，主财运；暴雨则需防口舌是非。"},
    {"keywords": ["太阳", "日出"], "category": "自然", "interpretation": "梦见太阳，大吉。预示前途光明，贵人扶持。"},
    {"keywords": ["月亮", "明月"], "category": "自然", "interpretation": "梦见月亮，主情感事顺利；女性梦之尤吉。"},
    {"keywords": ["怀孕", "生孩子", "孩子"], "category": "人事", "interpretation": "梦见生子，主家有喜庆；商人梦之主财源广进。"},
    {"keywords": ["结婚", "婚礼"], "category": "人事", "interpretation": "梦见结婚，主合作机会；未婚者主姻缘将至。"},
    {"keywords": ["死人", "葬礼", "棺材"], "category": "人事", "interpretation": "梦见死亡或棺材，多为反梦，主升官发财，旧我消亡新我生。"},
    {"keywords": ["哭", "流泪"], "category": "人事", "interpretation": "梦哭多反吉，预示忧愁将散。"},
    {"keywords": ["笑", "大笑"], "category": "人事", "interpretation": "梦笑，多为反梦，需防情绪波动。"},
    {"keywords": ["飞", "飞翔"], "category": "动作", "interpretation": "梦见自己飞翔，主自由与超越，预示突破。"},
    {"keywords": ["掉牙", "牙齿"], "category": "身体", "interpretation": "梦见掉牙，多主长辈安康需关注，或暗示新旧交替。"},
    {"keywords": ["头发", "剪发"], "category": "身体", "interpretation": "梦见剪发，主烦恼断除；脱发则需注意健康。"},
    {"keywords": ["血", "出血"], "category": "身体", "interpretation": "梦见血，主财；流血则主消耗，需调养身心。"},
    {"keywords": ["钱", "金钱", "捡钱"], "category": "财物", "interpretation": "梦见捡钱，多为反梦，需防破财；给钱则主得财。"},
    {"keywords": ["黄金", "金子", "宝石"], "category": "财物", "interpretation": "梦见黄金，主大财，事业有突破。"},
    {"keywords": ["车", "汽车", "开车"], "category": "事物", "interpretation": "梦见开车，主掌握主动；翻车需谨慎决策。"},
    {"keywords": ["房子", "新房", "买房"], "category": "事物", "interpretation": "梦见新房，主家运昌隆；旧屋倒塌则需防变故。"},
    {"keywords": ["考试", "高考", "学校"], "category": "事物", "interpretation": "梦见考试，反映心理压力，提示需平衡心态。"},
    {"keywords": ["迟到", "赶不上"], "category": "事件", "interpretation": "梦见迟到，反映焦虑情绪；现实中需重整节奏。"},
    {"keywords": ["迷路", "找不到路"], "category": "事件", "interpretation": "梦见迷路，预示方向迷茫，宜静心冷静三思。"},
    {"keywords": ["前任", "旧情人"], "category": "人事", "interpretation": "梦见前任，多为情感未解之结，并非现实复合预兆。"}
  ]
}
